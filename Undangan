<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Undangan Pernikahan - Winda & Arif</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@300;400;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --gold: #d4af37;
            --dark: #2c3e50;
            --cream: #fdfaf7;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--cream);
            color: var(--dark);
            margin: 0;
            overflow-x: hidden;
        }

        /* Hero Section dengan Background Candi Prambanan */
        .hero {
            height: 100vh;
            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), 
                        url('https://images.unsplash.com/photo-1625736465893-68f7608246e6?auto=format&fit=crop&q=80&w=1600') no-repeat center center/cover;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
            padding: 20px;
        }

        .hero h1 {
            font-family: 'Great Vibes', cursive;
            font-size: clamp(3.5rem, 12vw, 6rem);
            margin: 15px 0;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.5);
        }

        /* Countdown */
        #countdown {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 25px;
        }

        .time-box {
            background: rgba(153, 165, 83, 0.15);
            padding: 10px;
            border-radius: 12px;
            min-width: 80px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
        }

        .time-box span {
            display: block;
            font-weight: bold;
            font-size: 1.8rem;
        }

        /* Info Card */
        .section-padding {
            padding: 80px 20px;
        }

        .card-acara {
            background: white;
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            padding: 40px;
            height: 100%;
            border-bottom: 5px solid var(--gold);
        }

        /* Maps */
        .map-wrapper {
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            margin-top: 30px;
            height: 400px;
        }

        .btn-gold {
            background-color: var(--gold);
            color: white;
            border-radius: 50px;
            padding: 12px 35px;
            font-weight: bold;
            text-decoration: none;
            display: inline-block;
            transition: 0.3s;
            margin-top: 25px;
            border: none;
        }

        .btn-gold:hover {
            background-color: #b8962d;
            transform: translateY(-3px);
            color: white;
        }
    </style>
</head>
<body>

    <header class="hero">
        <div>
            <p class="text-uppercase" style="letter-spacing: 4px; font-weight: 300;">The Wedding of</p>
            <h1>Winda & Arif</h1>
            <p class="fs-5">Sabtu, 30 Agustus 2025</p>
            
            <div id="countdown">
                <div class="time-box"><span id="days">0</span> Hari</div>
                <div class="time-box"><span id="hours">0</span> Jam</div>
                <div class="time-box"><span id="mins">0</span> Menit</div>
            </div>
        </div>
    </header>

    <section class="section-padding container text-center">
        <h2 style="font-family: 'Great Vibes'; font-size: 3.5rem;" class="mb-5">Detail Acara</h2>
        <div class="row g-4 justify-content-center">
            <div class="col-md-5">
                <div class="card-acara">
                    <h3 class="fw-bold mb-3">Akad Nikah</h3>
                    <p class="mb-1">08.00 - 10.00 WIB</p>
                    <hr class="mx-auto w-25 my-3">
                    <p class="fw-bold">Horison Ultima Ratu</p>
                    <p class="small text-muted">Jl. K.H. Abdul Hadi No.66, Serang, Banten</p>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card-acara">
                    <h3 class="fw-bold mb-3">Resepsi</h3>
                    <p class="mb-1">11.00 - 14.00 WIB</p>
                    <hr class="mx-auto w-25 my-3">
                    <p class="fw-bold">Horison Ultima Ratu</p>
                    <p class="small text-muted">Kota Serang, Banten</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section-padding bg-white text-center">
        <div class="container">
            <h2 style="font-family: 'Great Vibes'; font-size: 3rem;">Lokasi Acara</h2>
            <p class="lead">Horison Ultima Ratu, Serang</p>
            
            <div class="map-wrapper">
                <iframe 
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3967.0423067169427!2d106.15546257448243!3d-6.125016560055104!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e41893da089f7f5%3A0x5774077d6f79fbc1!2sHotel%20Horison%20Ultima%20Ratu%20Serang!5e0!3m2!1sid!2sid!4v1705240000000!5m2!1sid!2sid" 
                    width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy">
                </iframe>
            </div>

            <a href="https://maps.app.goo.gl/ChIJ9feJgC31QS4RHfv5tHdAJwU" target="_blank" class="btn-gold">
                Petunjuk Jalan Google Maps
            </a>
        </div>
    </section>

    <footer class="text-center p-5 bg-light">
        <p class="mb-0 text-muted small">© 2025 Winda & Arif Wedding Invitation</p>
    </footer>

    <script>
        const targetDate = new Date("Aug 30, 2025 08:00:00").getTime();

        const x = setInterval(function() {
            const now = new Date().getTime();
            const distance = targetDate - now;

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));

            document.getElementById("days").innerHTML = days;
            document.getElementById("hours").innerHTML = hours;
            document.getElementById("mins").innerHTML = minutes;

            if (distance < 0) {
                clearInterval(x);
                document.getElementById("countdown").innerHTML = "<p class='fs-4'>HARI BAHAGIA TELAH TIBA!</p>";
            }
        }, 1000);
    </script>

</body>
</html>
