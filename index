<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dzikra Nura Dien | Portofolio</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #00d2ff;
            --secondary-color: #3a7bd5;
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --text-gray: #94a3b8;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-dark);
            color: white;
            scroll-behavior: smooth;
            overflow-x: hidden;
        }

        /* --- OVERLAY AWAL --- */
        #welcome-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at center, var(--secondary-color), var(--bg-dark));
            z-index: 10000;
            display: flex; align-items: center; justify-content: center;
            text-align: center;
            transition: 1s cubic-bezier(0.8, 0, 0.2, 1);
        }

        /* --- NAVBAR --- */
        .navbar {
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .nav-link { color: white !important; font-weight: 500; }
        .nav-link:hover { color: var(--primary-color) !important; }

        /* --- HERO --- */
        .hero {
            height: 100vh;
            display: flex; align-items: center;
            background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.8)), 
                        url('https://images.unsplash.com/photo-1625736465893-68f7608246e6?q=80&w=1600') no-repeat center center/cover;
        }
        .hero h1 { font-size: 3.5rem; font-weight: 700; }

        /* --- PROJECTS --- */
        .project-card {
            background: var(--card-bg);
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.1);
            transition: 0.4s;
            height: 100%;
        }
        .project-card:hover {
            transform: translateY(-10px);
            border-color: var(--primary-color);
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.2);
        }
        .project-img { height: 220px; object-fit: cover; width: 100%; background: #2d3748; }

        /* --- SOCIAL MEDIA --- */
        .social-link {
            font-size: 2rem;
            color: white;
            margin: 0 20px;
            transition: 0.3s;
            text-decoration: none;
        }
        .social-link:hover {
            color: var(--primary-color);
            transform: translateY(-5px);
        }
        
        .btn-main {
            background: linear-gradient(45deg, var(--primary-color), var(--secondary-color));
            color: white; border: none; padding: 12px 35px; border-radius: 50px; font-weight: 600;
            text-decoration: none; display: inline-block; transition: 0.3s;
        }
        .btn-main:hover { transform: scale(1.05); color: white; opacity: 0.9; }
    </style>
</head>
<body>

    <div id="welcome-overlay">
        <div class="p-3">
            <h4 class="fw-light mb-1">Portfolio of</h4>
            <h1 class="display-3 fw-bold mb-4">Dzikra Nura Dien</h1>
            <button class="btn-main shadow-lg" onclick="startApp()">MASUK PORTOFOLIO</button>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg fixed-top py-3">
        <div class="container">
            <a class="navbar-brand fw-bold text-white" href="#">DZIKRA<span style="color:var(--primary-color)">.DN</span></a>
            <div class="navbar-nav ms-auto d-none d-lg-flex">
                <a class="nav-link px-3" href="#home">Home</a>
                <a class="nav-link px-3" href="#projects">Projects</a>
                <a class="nav-link px-3" href="#contact">Contact</a>
            </div>
        </div>
    </nav>

    <section id="home" class="hero">
        <div class="container">
            <div class="row">
                <div class="col-lg-9">
                    <h5 class="text-info mb-3">Electronic Engineer & Web Enthusiast</h5>
                    <h1 class="mb-4">Membangun Solusi dengan <br><span style="color:var(--primary-color)">Kode & Perangkat Keras.</span></h1>
                    <p class="lead text-light mb-5">Lulusan Teknik Elektronika UNY. Berpengalaman sebagai instruktur robotika dan pengembang aplikasi berbasis Python.</p>
                    <a href="#projects" class="btn-main">Lihat Proyek Saya</a>
                </div>
            </div>
        </div>
    </section>

    <section id="projects" class="py-5">
        <div class="container py-5">
            <h2 class="text-center fw-bold mb-5">Featured Projects</h2>
            <div class="row g-4 justify-content-center">
                
                <div class="col-md-6 col-lg-5">
                    <div class="project-card">
                        <img src="https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800" class="project-img" alt="Wedding Website">
                        <div class="p-4">
                            <h4 class="fw-bold">Wedding Invitation Website</h4>
                            <p class="text-gray small">Website undangan digital dengan fitur animasi, hitung mundur otomatis, dan desain yang sepenuhnya responsif.</p>
                            <div class="mt-3">
                                <span class="badge bg-primary">HTML/CSS</span>
                                <span class="badge bg-info">JavaScript</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-5">
                    <div class="project-card">
                        <img src="https://images.unsplash.com/photo-1614732414444-af9613f3d1a3?q=80&w=800" class="project-img" alt="Space War Game">
                        <div class="p-4">
                            <h4 class="fw-bold">Space War Arcade Game</h4>
                            <p class="text-gray small">Game desktop berbasis Python Pygame yang melibatkan logika matematika, enemy AI, dan sistem partikel.</p>
                            <div class="mt-3">
                                <span class="badge bg-success">Python</span>
                                <span class="badge bg-warning text-dark">Pygame</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <section id="contact" class="py-5">
        <div class="container py-5 text-center">
            <div class="bg-dark p-5 rounded-5 shadow-lg border border-secondary">
                <h2 class="fw-bold mb-4">Mari Berkolaborasi</h2>
                <p class="text-gray mb-5">Klik salah satu ikon di bawah ini untuk menghubungi saya langsung.</p>
                
                <div class="d-flex justify-content-center align-items-center mb-5">
                    <a href="https://wa.me/6289639183926" target="_blank" class="social-link" title="WhatsApp">
                        <i class="fab fa-whatsapp"></i>
                    </a>
                    <a href="https://www.linkedin.com/in/dzikradn" target="_blank" class="social-link" title="LinkedIn">
                        <i class="fab fa-linkedin"></i>
                    </a>
                    <a href="https://instagram.com/dzikrardn" target="_blank" class="social-link" title="Instagram">
                        <i class="fab fa-instagram"></i>
                    </a>
                </div>

                <a href="mailto:dzikradn@email.com" class="text-info text-decoration-none fw-bold">dzikradn@email.com</a>
            </div>
        </div>
    </section>

    <footer class="py-4 text-center text-gray border-top border-secondary mt-5">
        <p class="small mb-0">© 2026 Dzikra Nura Dien. Crafted with VS Code.</p>
    </footer>

    <script>
        function startApp() {
            // Sembunyikan Overlay
            document.getElementById("welcome-overlay").style.transform = "translateY(-100%)";
            // Aktifkan Scroll
            document.body.style.overflow = "auto";
        }
        // Kunci scroll saat pertama buka
        document.body.style.overflow = "hidden";
    </script>

</body>
</html>
