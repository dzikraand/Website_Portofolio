import pygame
import sys
import random

# --- 1. INISIALISASI & PENGATURAN LAYAR ---
pygame.init()
SCREEN_WIDTH = 600
SCREEN_HEIGHT = 800
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Space War Arcade")
clock = pygame.time.Clock()
pygame.mouse.set_visible(False)  # Sembunyikan kursor

# --- 2. LOAD ASET GAMBAR (Pastikan file ini ada di folder) ---
try:
    player_ship  = pygame.image.load('player.png').convert_alpha()
    enemy_ship   = pygame.image.load('enemy.png').convert_alpha()
    ufo_ship     = pygame.image.load('ufo.png').convert_alpha()
    p_bullet_img = pygame.image.load('p_bullet.png').convert_alpha()
    e_bullet_img = pygame.image.load('e_bullet.png').convert_alpha()
    # Untuk ledakan (Part 5), kita load 5 gambar
    exp_images = [pygame.image.load(f'exp{i}.png').convert_alpha() for i in range(1, 6)]
except:
    print("Error: File PNG tidak ditemukan! Pastikan player.png, enemy.png, dll ada di folder.")
    pygame.quit()
    sys.exit()

# --- 3. KELAS-KELAS SPRITE ---

class Particle(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.image = pygame.Surface((2, 2))
        self.image.fill((169, 169, 169))
        self.rect = self.image.get_rect()
        self.rect.x = random.randint(0, SCREEN_WIDTH)
        self.rect.y = random.randint(0, SCREEN_HEIGHT)
        self.velocity = random.randint(3, 8)

    def update(self):
        self.rect.y += self.velocity
        if self.rect.y > SCREEN_HEIGHT:
            self.rect.y = -10
            self.rect.x = random.randint(0, SCREEN_WIDTH)

class Player(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.image = pygame.transform.scale(player_ship, (50, 50))
        self.rect = self.image.get_rect()
        self.alive = True

    def update(self):
        pos = pygame.mouse.get_pos()
        self.rect.center = pos

class Enemy(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.image = pygame.transform.scale(enemy_ship, (40, 40))
        self.rect = self.image.get_rect()
        self.rect.x = random.randint(80, SCREEN_WIDTH - 80) # Batas tepi (Part 6)
        self.rect.y = random.randint(-100, -40)
        self.speed = random.randint(2, 5)

    def update(self):
        self.rect.y += self.speed
        if self.rect.y > SCREEN_HEIGHT:
            self.rect.y = -50
            self.rect.x = random.randint(80, SCREEN_WIDTH - 80)

class Bullet(pygame.sprite.Sprite):
    def __init__(self, x, y, speed):
        super().__init__()
        self.image = p_bullet_img
        self.rect = self.image.get_rect(center=(x, y))
        self.speed = speed

    def update(self):
        self.rect.y += self.speed
        if self.rect.y < 0 or self.rect.y > SCREEN_HEIGHT:
            self.kill()

class Explosion(pygame.sprite.Sprite):
    def __init__(self, x, y):
        super().__init__()
        self.images = exp_images
        self.index = 0
        self.image = self.images[self.index]
        self.rect = self.image.get_rect(center=(x, y))

    def update(self):
        self.index += 1
        if self.index >= len(self.images):
            self.kill()
        else:
            self.image = self.images[self.index]

# --- 4. KELAS UTAMA GAME ---

class Game:
    def __init__(self):
        self.score = 0
        self.lives = 3
        self.font_l = pygame.font.SysFont("Calibri", 50)
        self.font_s = pygame.font.SysFont("Calibri", 25)
        self.init_create = True
        
        # Groups
        self.all_sprites = pygame.sprite.Group()
        self.enemies = pygame.sprite.Group()
        self.bullets = pygame.sprite.Group()
        self.particles = pygame.sprite.Group()
        
        for i in range(100):
            self.particles.add(Particle())

    def spawn_objects(self):
        if self.init_create:
            self.player = Player()
            self.all_sprites.add(self.player)
            for i in range(8):
                e = Enemy()
                self.enemies.add(e)
                self.all_sprites.add(e)
            self.init_create = False

    def draw_hud(self):
        pygame.draw.rect(screen, (0,0,0), (0, 0, SCREEN_WIDTH, 50)) # Top Bar
        score_txt = self.font_s.render(f"Score: {self.score}", True, (0, 255, 0))
        lives_txt = self.font_s.render(f"Lives: {self.lives}", True, (255, 0, 0))
        screen.blit(score_txt, (SCREEN_WIDTH - 150, 15))
        screen.blit(lives_txt, (20, 15))

    def start_screen(self):
        while True:
            screen.fill((0,0,0))
            self.particles.update()
            self.particles.draw(screen)
            
            txt = self.font_l.render("SPACE WAR", True, (0, 0, 255))
            screen.blit(txt, (SCREEN_WIDTH//2 - 110, SCREEN_HEIGHT//2 - 50))
            sub = self.font_s.render("Press ENTER to Start", True, (255, 255, 255))
            screen.blit(sub, (SCREEN_WIDTH//2 - 90, SCREEN_HEIGHT//2 + 20))
            
            pygame.display.update()
            for event in pygame.event.get():
                if event.type == pygame.QUIT: pygame.quit(); sys.exit()
                if event.type == pygame.KEYDOWN and event.key == pygame.K_RETURN:
                    self.run_game()

    def pause_screen(self):
        txt = self.font_l.render("PAUSED", True, (255, 255, 255))
        screen.blit(txt, (SCREEN_WIDTH//2 - 80, SCREEN_HEIGHT//2))
        pygame.display.update()
        while True:
            for event in pygame.event.get():
                if event.type == pygame.QUIT: pygame.quit(); sys.exit()
                if event.type == pygame.KEYDOWN and event.key == pygame.K_SPACE:
                    return

    def game_over_screen(self):
        while True:
            screen.fill((0,0,0))
            txt = self.font_l.render("GAME OVER", True, (255, 0, 0))
            screen.blit(txt, (SCREEN_WIDTH//2 - 120, SCREEN_HEIGHT//2 - 50))
            btn = self.font_s.render("Press ESC for Menu", True, (0, 255, 0))
            screen.blit(btn, (SCREEN_WIDTH//2 - 95, SCREEN_HEIGHT//2 + 50))
            pygame.display.update()
            for event in pygame.event.get():
                if event.type == pygame.QUIT: pygame.quit(); sys.exit()
                if event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                    self.__init__() # Reset Game
                    self.start_screen()

    def run_game(self):
        self.spawn_objects()
        while True:
            screen.fill((0,0,0))
            for event in pygame.event.get():
                if event.type == pygame.QUIT: pygame.quit(); sys.exit()
                if event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_SPACE: self.pause_screen()
                if event.type == pygame.MOUSEBUTTONDOWN:
                    # Tembak Peluru
                    b = Bullet(self.player.rect.centerx, self.player.rect.top, -18)
                    self.bullets.add(b)
                    self.all_sprites.add(b)

            # Update
            self.particles.update()
            self.all_sprites.update()

            # Cek Tabrakan Peluru vs Musuh
            hits = pygame.sprite.groupcollide(self.enemies, self.bullets, True, True)
            for hit in hits:
                self.score += 10
                self.all_sprites.add(Explosion(hit.rect.centerx, hit.rect.centery))
                e = Enemy()
                self.enemies.add(e)
                self.all_sprites.add(e)

            # Cek Tabrakan Pemain vs Musuh
            if pygame.sprite.spritecollide(self.player, self.enemies, True):
                self.lives -= 1
                self.all_sprites.add(Explosion(self.player.rect.centerx, self.player.rect.centery))
                if self.lives <= 0: self.game_over_screen()
                e = Enemy()
                self.enemies.add(e)
                self.all_sprites.add(e)

            # Draw
            self.particles.draw(screen)
            self.all_sprites.draw(screen)
            self.draw_hud()

            pygame.display.flip()
            clock.tick(60)

# --- JALANKAN ---
if __name__ == "__main__":
    game = Game()
    game.start_screen()
